# server/.env for a real launch, behind deploy/Caddyfile. Copy it to server/.env and fill in
# every blank. Then run `npm run launch-check` in server/: it must report nothing to fix.
# All settings are explained in the README (Configuration).

NODE_ENV=production
PORT=3001
# Your domain. Every SMS and email link (live location, sign-up, password reset) uses it.
APP_URL=https://herspace.example
PUBLIC_API_URL=https://herspace.example
CORS_ORIGIN=https://herspace.example
# Caddy is one proxy in front of the API.
TRUST_PROXY=1

# Twilio (twilio.com): SOS texts and calls, contact invites.
# In Twilio, turn on Geo Permissions for SMS and voice and allow only the countries you need.
# For Indian numbers, register the sender ID and message templates on TRAI DLT first, or
# texts are silently dropped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SOS_VOICE_CALLS=true

# Resend (resend.com): sign-up, password reset and HR notification emails. Verify your domain
# in Resend so emails aren't marked as spam.
RESEND_API_KEY=
EMAIL_FROM=HerSpace <no-reply@herspace.example>

# Anthropic (console.anthropic.com): the support chat, fake caller and report drafting.
# Set a monthly spending limit in the Anthropic console as well as AI_DAILY_LIMIT here.
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=2000

# A long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HERSPACE_SECRET=

# Keep these on storage that survives restarts, and back them up.
DATABASE_PATH=/srv/herspace/data/herspace.db
UPLOAD_DIR=/srv/herspace/data/uploads

# Area names and nearby help come from OpenStreetMap. The public servers don't allow app
# traffic: use your own instance or a provider, or turn them off.
NOMINATIM_URL=off
OVERPASS_URL=off

EMERGENCY_NUMBER=112
SOS_RETENTION_DAYS=90
