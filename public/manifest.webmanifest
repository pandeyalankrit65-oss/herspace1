{
  "name": "HerSpace",
  "short_name": "HerSpace",
  "description": "SOS alerts to trusted contacts, incident reporting, a community safety map and AI support.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#121216",
  "theme_color": "#121216",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Emergency SOS", "short_name": "SOS", "url": "/sos", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
