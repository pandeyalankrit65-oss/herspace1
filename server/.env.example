# Copy to server/.env and fill in. Everything is optional; missing values fall back safely.

PORT=3001
# Frontend URL, used in links sent by SMS/email (contact invites, password resets).
APP_URL=http://localhost:8080
# Comma-separated origins allowed to call the API directly (the Vite dev proxy doesn't need this).
CORS_ORIGIN=http://localhost:8080
# Number of reverse proxies in front of the server in production (e.g. 1), so rate limits see real IPs.
# TRUST_PROXY=1
# SQLite file location (default: server/data/herspace.db)
# DATABASE_PATH=
# Days to keep SOS locations before they're deleted automatically.
SOS_RETENTION_DAYS=90
# Map reports with this many community flags are hidden.
MAP_FLAG_THRESHOLD=3

# Emergency number mentioned by the support chat.
EMERGENCY_NUMBER=112

# Twilio: required for SOS alerts and contact invites to be sent by SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Also ring confirmed contacts with an automated voice call during a real SOS.
SOS_VOICE_CALLS=false
# Public URL of this API. Enables SMS/call delivery confirmations via Twilio callbacks.
# PUBLIC_API_URL=https://api.example.com

# Resend: sends password reset emails. Without it, reset links are only logged in development.
RESEND_API_KEY=
EMAIL_FROM=HerSpace <no-reply@example.com>

# Anthropic: powers the AI support chat. Without it the chat uses simple scripted replies.
ANTHROPIC_API_KEY=

# Force the Secure flag on the session cookie (default: on when NODE_ENV=production).
# COOKIE_SECURE=true
